# Optional live GenAI provider. Credentials stay server-side.
IMAGE_PROVIDER=auto

# Preferred: Adobe Firefly Services (Image5 Generate Image API)
FIREFLY_SERVICES_CLIENT_ID=
FIREFLY_SERVICES_CLIENT_SECRET=

# Optional fallback provider
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Optional Google Gemini / Nano Banana Pro provider
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image

PORT=3001
